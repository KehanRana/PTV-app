# Copy to .env for local development. Never commit real credentials.
# Keep this file and .env outside dist/; credentials must remain server-side.

# Local PostgreSQL connection; replace credentials for your environment.
DATABASE_URL=postgresql://ontrack:change_me@localhost:5432/ontrack

# Victorian GTFS-Realtime access. Confirm the header name and feed URLs
# against the documentation supplied with your API access.
GTFS_API_KEY=
GTFS_API_KEY_HEADER=
GTFS_TRAIN_TRIP_UPDATES_URL=
GTFS_TRAIN_VEHICLE_POSITIONS_URL=
GTFS_TRAM_TRIP_UPDATES_URL=
GTFS_TRAM_VEHICLE_POSITIONS_URL=
GTFS_BUS_TRIP_UPDATES_URL=
GTFS_BUS_VEHICLE_POSITIONS_URL=
GTFS_STATIC_URL=

# Polling and retries. Retries must also consume the rate-limit budget.
POLL_INTERVAL_SECONDS=30
HTTP_TIMEOUT_SECONDS=20
RETRY_INITIAL_DELAY_SECONDS=5
RETRY_MAX_DELAY_SECONDS=300
# Required before enabling ingestion: confirmed per-mode request budgets.
# Leave blank until verified; the collector should fail closed if unset.
TRAIN_REQUESTS_PER_MINUTE=
TRAM_REQUESTS_PER_MINUTE=
BUS_REQUESTS_PER_MINUTE=
RATE_LIMIT_SAFETY_MARGIN_PERCENT=20

# Storage and processing. Store timestamps in UTC; display in Melbourne time.
RAW_RETENTION_DAYS=7
DISPLAY_TIMEZONE=Australia/Melbourne
STATS_INTERVAL_MINUTES=60
# Proposed definition, pending validation against official mode definitions.
# Inclusive early boundary; exclusive late boundary.
ON_TIME_EARLY_SECONDS=60
ON_TIME_LATE_SECONDS=360
MIN_SAMPLE_COUNT=200

# Feed health and logging.
FEED_STALE_THRESHOLD_SECONDS=300
LOG_LEVEL=info
